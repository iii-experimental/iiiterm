{
  "name": "iiiterm",
  "version": "0.1.0",
  "description": "Operator surface for agent swarms on iii. Watches Claude Code / Codex / OpenCode / Amp transcripts, pushes state to iii engine, renders to tmux pane and browser peer.",
  "type": "module",
  "bin": {
    "iiiterm": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "dev:bridge": "tsx src/workers/bridge-claude-code.ts",
    "dev:tui": "tsx src/workers/tui.ts",
    "lint": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "iii",
    "iii-engine",
    "agents",
    "tmux",
    "claude-code",
    "codex",
    "opencode",
    "multi-agent",
    "operator",
    "tui"
  ],
  "license": "MIT",
  "author": "Rohit Ghumare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iii-experimental/iiiterm.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "iii-sdk": "^0.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
