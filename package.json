{
  "name": "iiiterm",
  "version": "0.1.0",
  "description": "Operator surface for agent swarms on iii. Watches Claude Code / Codex / OpenCode / Amp transcripts, pushes state to iii engine, renders to tmux pane and browser peer.",
  "type": "module",
  "bin": {
    "iiiterm": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "dev:bridge": "tsx src/workers/bridge-claude-code.ts",
    "dev:codex": "tsx src/workers/bridge-codex.ts",
    "dev:opencode": "tsx src/workers/bridge-opencode.ts",
    "dev:router": "tsx src/workers/bridge-router.ts",
    "dev:actions": "tsx src/workers/actions.ts",
    "dev:tmux": "tsx src/workers/bridge-tmux.ts",
    "dev:claude-worker": "tsx src/workers/claude-worker.ts",
    "dev:codex-worker": "tsx src/workers/codex-worker.ts",
    "dev:opencode-worker": "tsx src/workers/opencode-worker.ts",
    "dev:amp-worker": "tsx src/workers/amp-worker.ts",
    "dev:tui": "tsx src/workers/tui.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "iii",
    "iii-engine",
    "agents",
    "tmux",
    "claude-code",
    "codex",
    "opencode",
    "multi-agent",
    "operator",
    "tui"
  ],
  "license": "MIT",
  "author": "Rohit Ghumare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iii-experimental/iiiterm.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "iii-sdk": "^0.11.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
